private_history/
test_artifacts*/
tests/
runs/
logs/
cache/
.cache/
data/
datasets/
checkpoints/
*_PRIVATE_AUDIT/
*.log
__pycache__/
*.py[cod]
.venv/
.env
.env.*
*.pem
