# Allow only the two reviewed Python source files under the otherwise private data namespace.
!datasets/
datasets/*
!datasets/__init__.py
!datasets/ki_preference_dataset.py
!datasets/README.md
!datasets/SOURCES.md

.venv-model/

# Explicit public resource documentation and manifests; binary/data payloads remain ignored.
!checkpoint_manifest.csv
!dataset_manifest.csv
!evaluation_manifest.csv
!checkpoints/
checkpoints/*
!checkpoints/README.md
!data/
data/*
!data/README.md
